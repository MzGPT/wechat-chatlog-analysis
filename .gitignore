uvicorn.log
*.log
.uvicorn.pid
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Backups
backups/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temp
.jiebang/
.playwright-mcp/
